{
  "name": "neocalc-pro",
  "version": "0.1.2",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build && node scripts/finalize-pwa.mjs",
    "test": "npm run test:unit && npm run test:ui && npm run build && npm run test:pwa",
    "test:unit": "node --import tsx --test --test-isolation=none src/*.test.ts",
    "test:ui": "vitest run --config vitest.config.ts",
    "test:pwa": "node --test --test-isolation=none scripts/pwa.test.mjs"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "fake-indexeddb": "^6.2.7",
    "jsdom": "^26.1.0",
    "prettier": "^3.9.10",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=22.8.0"
  }
}
